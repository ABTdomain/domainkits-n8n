{
	"name": "Brand watch: newly registered domains",
	"nodes": [
		{
			"parameters": {
				"rule": {
					"interval": [
						{
							"field": "days",
							"triggerAtHour": 8
						}
					]
				}
			},
			"id": "a1000000-0000-0000-0000-000000000001",
			"name": "Every morning",
			"type": "n8n-nodes-base.scheduleTrigger",
			"typeVersion": 1.2,
			"position": [0, 0]
		},
		{
			"parameters": {
				"resource": "nrd",
				"operation": "search",
				"searchMode": "keyword",
				"keyword": "yourbrand",
				"limit": 100,
				"filters": {
					"reg_date": "={{ $now.minus({ days: 1 }).toFormat('yyyy-MM-dd') }}"
				}
			},
			"id": "a1000000-0000-0000-0000-000000000002",
			"name": "New registrations containing brand",
			"type": "n8n-nodes-domainkits.domainKits",
			"typeVersion": 1,
			"position": [220, 0]
		},
		{
			"parameters": {
				"aggregate": "aggregateAllItemData",
				"options": {}
			},
			"id": "a1000000-0000-0000-0000-000000000003",
			"name": "Combine into one list",
			"type": "n8n-nodes-base.aggregate",
			"typeVersion": 1,
			"position": [440, 0]
		},
		{
			"parameters": {
				"assignments": {
					"assignments": [
						{
							"id": "b1000000-0000-0000-0000-000000000001",
							"name": "subject",
							"value": "={{ $json.data.length }} new domain registrations containing your brand",
							"type": "string"
						},
						{
							"id": "b1000000-0000-0000-0000-000000000002",
							"name": "message",
							"value": "={{ $json.data.map(d => d.domain + '  (registered ' + d.registered_date + ', expires ' + d.expiry_date + ')').join('\\n') }}",
							"type": "string"
						}
					]
				},
				"options": {}
			},
			"id": "a1000000-0000-0000-0000-000000000004",
			"name": "Build alert text",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [660, 0]
		}
	],
	"connections": {
		"Every morning": {
			"main": [
				[
					{
						"node": "New registrations containing brand",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"New registrations containing brand": {
			"main": [
				[
					{
						"node": "Combine into one list",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Combine into one list": {
			"main": [
				[
					{
						"node": "Build alert text",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"settings": {
		"executionOrder": "v1"
	},
	"pinData": {}
}
